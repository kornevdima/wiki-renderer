{
  "name": "wiki-renderer",
  "version": "0.1.0",
  "description": "Local, read-only renderer for Obsidian-flavoured Markdown wikis on disk.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "24"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "$typescript"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "node scripts/eslint-ts6.cjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@shikijs/rehype": "4.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "get-nonce": "1.0.1",
    "github-slugger": "2.0.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "lucide-react": "1.46.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.0.0",
    "minisearch": "7.2.0",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "pino": "10.3.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "shiki": "4.4.3",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "parse5": "8.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
