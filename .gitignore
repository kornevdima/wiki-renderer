# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (US-007)
/test-results
/playwright-report
/.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the secret-free template IS committed (documents every env var).
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/settings.local.json

# IDE
.idea/
/build-cli
/release

# ADLC working records (contracts, reviews, verification, census, measurements, screenshots) stay on this
# machine: they carry local paths and machine details, and this repository is public (operator 2026-10-18).
/wiki/census/*
/wiki/contracts/*
/wiki/reviews/*
/wiki/verification/*
/wiki/measurements/*
!/wiki/*/.gitkeep
