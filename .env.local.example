# Copy to .env.local and adjust. .env.local is gitignored.

# Required. Comma-separated `id=folder` pairs; a bare folder takes its id from the folder name
# (or the parent's, when the folder is called `wiki`). Relative paths resolve from this repo; `~/` from HOME.
WIKI_DIRS=notes=~/notes/wiki

# Optional (code defaults shown).
# How often a request re-fingerprints a folder (stat only); edits show after this window.
# WIKI_RECHECK_MS=1000
# Total bytes one wiki may load into memory (200 MB).
# WIKI_MAX_BYTES=209715200
# How long a folder must have been unreadable before the reader shows the staleness notice.
# WIKI_SNAPSHOT_STALE_NOTICE_MS=0
# LOG_LEVEL=info
